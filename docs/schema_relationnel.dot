digraph ER {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.62", ranksep="1.1", splines=polyline, overlap=false, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#8099AB",fontname="DejaVu Sans",fontsize=9,penwidth=1.4,arrowsize=0.6];
